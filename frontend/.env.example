# Backend origin (NestJS). Server-side only: the browser calls /api/v1 on this app and Next forwards it here.
API_ORIGIN=http://localhost:5000

# Google/GitHub sign-in buttons. Keep false until OAuth credentials exist (docs: external accounts step); then the buttons redirect to the backend.
NEXT_PUBLIC_OAUTH_ENABLED=false

# Portfolio demo deployment only (no custom domain, so email codes only reach the project owner): shows three ready demo accounts on the sign-in page and a note on the
# sign-up page. Leave both unset anywhere else. The password is public on purpose and must equal the DEMO_PASSWORD used when running `npm run demo:seed` in backend/.
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_DEMO_PASSWORD=your-public-demo-password
