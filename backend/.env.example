# ============================================================================
# VEYRO ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================================
# Copy this file to backend/.env and fill in the values for your environment.
# NEVER commit the actual .env file or real secrets to version control.

# ----------------------------------------------------------------------------
# 1. Server & Application Settings
# ----------------------------------------------------------------------------
NODE_ENV="development"
PORT=5000
APP_URL="http://localhost:3000"
API_URL="http://localhost:5000/api/v1"

# ----------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16+ or Neon Serverless)
# ----------------------------------------------------------------------------
# Optional, local only: a Neon dev branch. When set it wins over DATABASE_URL outside production, so development and the tests never
# touch the main branch (the variable is ignored in production). Create the branch with NO expiry, or Neon deletes it.
# DATABASE_URL_Branch="postgresql://user:password@ep-dev-branch-pooler.us-east-2.aws.neon.tech/veyro?sslmode=require"
# Local Development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veyro?schema=public"
# Neon Cloud (Production / Cloud Staging):
# DATABASE_URL="postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/veyro?sslmode=require"

# ----------------------------------------------------------------------------
# 3. Authentication & JWT Session Configuration
# ----------------------------------------------------------------------------
# Required: the app refuses to start without it (min 32 characters, not this placeholder). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-secure-random-secret-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# Number of reverse proxies in front of the API (Next.js rewrite, load balancer). Needed in production so rate limits see
# the real client IP. Leave unset when the API is reached directly.
# TRUST_PROXY=1

# ----------------------------------------------------------------------------
# 4. Social sign-in (Google, GitHub). Also set NEXT_PUBLIC_OAUTH_ENABLED=true in frontend/.env.local.
# ----------------------------------------------------------------------------
# Google OAuth: Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Register this exact URL in Google Cloud Console (Authorized redirect URIs). It goes through the Next.js app so the session cookies stay first-party;
# in production use https://<your-domain>/api/v1/auth/google/callback.
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/google/callback"

# GitHub OAuth: Obtain from GitHub -> Settings -> Developer Settings -> OAuth Apps
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
# Same idea for the GitHub OAuth App (Authorization callback URL).
GITHUB_CALLBACK_URL="http://localhost:3000/api/v1/auth/github/callback"

# ----------------------------------------------------------------------------
# 5. Payments (Stripe, USD, monthly plans). Optional in development (checkout answers 503 and the webhook stays closed); required in production.
# ----------------------------------------------------------------------------
# Secret key: Stripe Dashboard > Developers > API keys, or the key of a sandbox made with `stripe sandboxes create`. Use a TEST key until launch.
STRIPE_SECRET_KEY="sk_test_replace_with_your_secret_key"
# Signs the webhook calls. Local: `stripe listen --print-secret` and keep `stripe listen --forward-to localhost:5000/api/v1/billing/webhook` running.
# Production: the secret of the webhook endpoint you register in the Dashboard.
STRIPE_WEBHOOK_SECRET="whsec_replace_with_signing_secret"
# One recurring monthly price per paid plan ($9 / $19 / $29), created in the Dashboard (Product catalog) or with the CLI.
STRIPE_PRICE_ID_PRO="price_replace_pro"
STRIPE_PRICE_ID_ENTERPRISE="price_replace_enterprise"
STRIPE_PRICE_ID_EPIC="price_replace_epic"
# Optional: the Customer Portal configuration to use (card, invoices, cancel). Leave empty to use the account default.
STRIPE_PORTAL_CONFIG_ID=""
# Set to true only for a demo deployment that runs on Stripe test keys (no real charges). Without it the app refuses test keys in production.
# STRIPE_ALLOW_TEST_KEYS=true

# ----------------------------------------------------------------------------
# 6. AI assistant (Google Gemini). Optional in development (without a key the assistant answers with a fixed stand-in text); required in production.
# ----------------------------------------------------------------------------
# Key from Google AI Studio (aistudio.google.com > Get API key). The free tier may use prompts to improve Google products: demo data only.
GEMINI_API_KEY="your-gemini-api-key"
# Optional: the model to call. Default gemini-3.5-flash-lite (cheap and fast).
# AI_MODEL="gemini-3.5-flash-lite"
# Optional: the model that turns help documents and questions into vectors. Changing it means re-running the ingest AND re-measuring MIN_SIMILARITY.
# AI_EMBEDDING_MODEL="gemini-embedding-001"
# The help documents the assistant answers from live in backend/knowledge/<en|ar>/*.md. After editing them (and after the migration on a new database):
#   npm run knowledge:ingest                       (dev branch / local)
#   NODE_ENV=production npm run knowledge:ingest   (production database)

# ----------------------------------------------------------------------------
# 6b. Profile photos (Cloudinary). Optional in development (the photo button reports "not set up"); required in production.
# ----------------------------------------------------------------------------
# Cloudinary dashboard > Settings > API Keys. The API secret stays in this file only: never in the frontend, chat or git.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="replace-with-your-api-secret"
# Optional: the Cloudinary folder every file goes under (default "Veyro", the product name). Photos land in <folder>/avatars/<userId>.
# CLOUDINARY_FOLDER="Veyro"

# ----------------------------------------------------------------------------
# 7. Email (Resend: verification codes, password reset, invitations, contact form)
# ----------------------------------------------------------------------------
# API key from resend.com > API Keys. Optional in development (emails are skipped with a log line); required in production.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Sender. "Veyro <onboarding@resend.dev>" is Resend's test sender (testing only, refused in production). In production use an
# address on a domain you verified in Resend, for example "Veyro <noreply@yourdomain.com>".
EMAIL_FROM="Veyro <onboarding@resend.dev>"
# Where contact-form messages are emailed (the message is always stored in the database too). Leave empty to disable.
CONTACT_INBOX="team@example.com"

# ----------------------------------------------------------------------------
# 8. Local development helpers
# ----------------------------------------------------------------------------
# Also prints verification codes and reset links in the backend console. NEVER true in production.
DEV_OUTBOX=false
