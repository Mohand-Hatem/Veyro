# ============================================================================
# VEYRO ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================================
# Copy this file to backend/.env and fill in the values for your environment.
# NEVER commit the actual .env file or real secrets to version control.

# ----------------------------------------------------------------------------
# 1. Server & Application Settings
# ----------------------------------------------------------------------------
NODE_ENV="development"
PORT=5000
APP_URL="http://localhost:3000"
API_URL="http://localhost:5000/api/v1"

# ----------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16+ or Neon Serverless)
# ----------------------------------------------------------------------------
# Local Development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veyro?schema=public"
# Neon Cloud (Production / Cloud Staging):
# DATABASE_URL="postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/veyro?sslmode=require"

# ----------------------------------------------------------------------------
# 3. Authentication & JWT Session Configuration
# ----------------------------------------------------------------------------
JWT_SECRET="replace-with-a-cryptographically-secure-random-secret-key-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ----------------------------------------------------------------------------
# 4. Social OAuth 2.0 Credentials (Configured in Phase 5 Live Testing)
# ----------------------------------------------------------------------------
# Google OAuth: Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

# GitHub OAuth: Obtain from GitHub -> Settings -> Developer Settings -> OAuth Apps
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_CALLBACK_URL="http://localhost:5000/api/v1/auth/github/callback"

# ----------------------------------------------------------------------------
# 5. Billing & Payment Gateway Configuration
# ----------------------------------------------------------------------------
# Stripe Webhook Secret: Obtain via Stripe Dashboard -> Developers -> Webhooks (or `stripe listen`)
STRIPE_WEBHOOK_SECRET="whsec_replace_with_stripe_signing_secret"
STRIPE_SECRET_KEY="sk_test_replace_with_stripe_secret_key"

# ----------------------------------------------------------------------------
# 6. AI Gateway Configuration (Phase 5 Live LLM Integration)
# ----------------------------------------------------------------------------
# Gemini / OpenAI API Key for live assistant responses
AI_GATEWAY_API_KEY="your-ai-gateway-api-key"

# ----------------------------------------------------------------------------
# 7. Local development helpers
# ----------------------------------------------------------------------------
# Prints verification codes and reset links in the backend console while no email provider exists. NEVER true in production.
DEV_OUTBOX=false
