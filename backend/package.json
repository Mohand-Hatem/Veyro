{
  "name": "veyro-backend",
  "version": "1.0.0",
  "description": "Veyro Production Modular Monolith Backend (NestJS + Prisma ORM 7 + PostgreSQL)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "test": "ts-node --transpile-only test/backend-flows.spec.ts && npm run test:cs01 && npm run test:cs02 && npm run test:cs03 && npm run test:cs04 && npm run test:cs05 && npm run test:cs06 && npm run test:cs07 && npm run test:cs08 && npm run test:cs09 && npm run test:cs10 && npm run test:cs11 && npm run test:cs14",
    "test:cs10": "ts-node --transpile-only test/cs10-contact.spec.ts",
    "test:cs09": "ts-node --transpile-only test/cs09-profile.spec.ts",
    "test:cs08": "ts-node --transpile-only test/cs08-projects-and-my-tasks.spec.ts",
    "test:cs07": "ts-node --transpile-only test/cs07-account-governance.spec.ts",
    "test:cs06": "ts-node --transpile-only test/cs06-ai-proposals.spec.ts",
    "test:cs05": "ts-node --transpile-only test/cs05-project-roles.spec.ts",
    "test:cs14": "ts-node --transpile-only test/cs14-workspace-limit.spec.ts",
    "test:cs11": "ts-node --transpile-only test/cs11-invitation-preview.spec.ts",
    "test:cs04": "ts-node --transpile-only test/cs04-board-contract.spec.ts",
    "test:cs03": "ts-node --transpile-only test/cs03-audit-enrichment.spec.ts",
    "test:cs02": "ts-node --transpile-only test/cs02-workspace-admin.spec.ts",
    "test:cs01": "ts-node --transpile-only test/cs01-audit.spec.ts && ts-node --transpile-only test/cs01-completed-at.spec.ts && ts-node --transpile-only test/cs01-project-key.spec.ts && ts-node --transpile-only test/cs01-dashboard.spec.ts && ts-node --transpile-only test/cs01-invitation-projects.spec.ts && ts-node --transpile-only test/cs01-http-smoke.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^11.0.11",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.11",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "bcrypt@6.0.0": true
  }
}
