{
  "name": "veyro-backend",
  "version": "1.0.0",
  "description": "Veyro Production Modular Monolith Backend (NestJS + Prisma ORM 7 + PostgreSQL)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "ai:eval": "ts-node --transpile-only scripts/ai-eval.ts",
    "knowledge:ingest": "ts-node --transpile-only scripts/ingest-knowledge.ts",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "test": "ts-node --transpile-only -r ./test/helpers/no-real-email.js test/backend-flows.spec.ts && npm run test:cs01 && npm run test:cs02 && npm run test:cs03 && npm run test:cs04 && npm run test:cs05 && npm run test:cs06 && npm run test:cs07 && npm run test:cs08 && npm run test:cs09 && npm run test:cs10 && npm run test:cs11 && npm run test:cs14 && npm run test:p51 && npm run test:p52 && npm run test:p53 && npm run test:p54 && npm run test:p55 && npm run test:p56 && npm run test:p57 && npm run test:p58 && npm run test:p59 && npm run test:p60 && npm run test:p61 && npm run test:p62 && npm run test:p63 && npm run test:p64 && npm run test:p65",
    "demo:seed": "ts-node --transpile-only -r ./test/helpers/no-real-email.js scripts/demo-seed.ts",
    "parity:seed-profile": "ts-node --transpile-only scripts/parity-seed-profile.ts",
    "perf:baseline": "ts-node --transpile-only -r ./test/helpers/no-real-email.js scripts/perf-baseline.ts",
    "test:p65": "ts-node --transpile-only -r ./test/helpers/no-real-email.js test/p65-jobs.spec.ts",
    "test:p64": "ts-node --transpile-only -r ./test/helpers/no-real-email.js test/p64-user-deletion.spec.ts",
    "test:p57": "ts-node --transpile-only -r ./test/helpers/no-real-email.js test/p57-stripe.spec.ts",
    "test:p58": "ts-node --transpile-only -r ./test/helpers/no-real-email.js test/p58-ai-gateway.spec.ts",
    "test:p59": "ts-node --transpile-only -r ./test/helpers/no-real-email.js test/p59-knowledge.spec.ts",
    "test:p60": "ts-node --transpile-only -r ./test/helpers/no-real-email.js test/p60-ai-tools.spec.ts",
    "test:p61": "ts-node --transpile-only -r ./test/helpers/no-real-email.js test/p61-ai-quota.spec.ts",
    "test:p62": "ts-node --transpile-only -r ./test/helpers/no-real-email.js test/p62-avatar.spec.ts",
    "test:p63": "ts-node --transpile-only -r ./test/helpers/no-real-email.js test/p63-notifications.spec.ts",
    "test:p56": "ts-node --transpile-only -r ./test/helpers/no-real-email.js test/p56-oauth.spec.ts",
    "test:p55": "ts-node --transpile-only -r ./test/helpers/no-real-email.js test/p55-email.spec.ts",
    "test:p54": "ts-node --transpile-only -r ./test/helpers/no-real-email.js test/p54-journeys.spec.ts",
    "test:p53": "ts-node --transpile-only -r ./test/helpers/no-real-email.js test/p53-reliability.spec.ts",
    "test:p52": "ts-node --transpile-only -r ./test/helpers/no-real-email.js test/p52-isolation-matrix.spec.ts",
    "test:p51": "ts-node --transpile-only -r ./test/helpers/no-real-email.js test/p51-security.spec.ts",
    "test:cs10": "ts-node --transpile-only -r ./test/helpers/no-real-email.js test/cs10-contact.spec.ts",
    "test:cs09": "ts-node --transpile-only -r ./test/helpers/no-real-email.js test/cs09-profile.spec.ts",
