    "test:cs11": "ts-node --transpile-only -r ./test/helpers/no-real-email.js test/cs11-invitation-preview.spec.ts",
    "test:cs04": "ts-node --transpile-only -r ./test/helpers/no-real-email.js test/cs04-board-contract.spec.ts",
