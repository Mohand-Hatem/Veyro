// ============================================================================
// Veyro Database Schema (Prisma ORM 7 / PostgreSQL 16+)
// Document Reference: docs/04-ENTITY-RELATIONSHIP-SPECIFICATION.md
// Phase 2: STEP-2.2 Physical Schema Design
// ============================================================================

datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

// ============================================================================
// 1. Identity & Session Models
// ============================================================================

model User {
  id              String     @id @default(cuid(2))
  email           String     @unique
  passwordHash    String
  name            String
  /// What the person sees (step 5.9a): the picture's address, or null for initials. Always written together with avatarType and avatarPresetKey by AvatarService.
  avatarUrl       String?
  avatarType      AvatarType @default(INITIALS)
  /// Set only when avatarType is PRESET: the key of one of the fixed illustrated avatars (their files live in the frontend).
  avatarPresetKey String?
  /// Set while a photo we stored is kept hidden (private) after the person removed it; the retention purge deletes it after 30 days.
  avatarRemovedAt DateTime?
  /// Display preferences (CS-09): saved on the account so they follow the person to every device.
  locale          UserLocale @default(EN)
  theme           UserTheme  @default(SYSTEM)
  isEmailVerified Boolean    @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relationships
  ownedAccounts            Account[]                @relation("AccountOwner")
  sessions                 UserSession[]
  workspaceMemberships     WorkspaceMember[]
  projectMemberships       ProjectMember[]
  createdProjects          Project[]                @relation("ProjectCreator")
  authoredTasks            Task[]                   @relation("TaskAuthor")
  assignedTasks            Task[]                   @relation("TaskAssignee")
  taskComments             TaskComment[]
  aiSubscription           UserAiSubscription?
  aiUsageRecords           AiDailyUsage[]
  aiUsageReservations      AiUsageReservation[]
  aiConversations          AiConversation[]
  sentWorkspaceInvitations WorkspaceInvitation[]    @relation("WorkspaceInviter")
  otpVerifications         UserOtpVerification[]
  passwordResetTokens      UserPasswordResetToken[]
  notificationsReceived    Notification[]           @relation("NotificationRecipient")
  notificationsCaused      Notification[]           @relation("NotificationActor")

  @@map("users")
}

enum AvatarType {
  INITIALS
  PRESET
  /// A picture address: a photo we stored in Cloudinary, or the Google/GitHub photo copied at sign-in.
  UPLOAD
}

enum UserLocale {
  EN
  AR
}

enum UserTheme {
  LIGHT
  DARK
  SYSTEM
}

model UserSession {
  id          String   @id @default(cuid(2))
  userId      String
  hashedToken String   @unique
  familyId    String
  isRevoked   Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("user_sessions")
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model UserOtpVerification {
  id                String     @id @default(cuid(2))
  userId            String
  email             String
  codeHash          String
  purpose           OtpPurpose @default(EMAIL_VERIFICATION)
  attempts          Int        @default(0)
  maxAttempts       Int        @default(5)
  isConsumed        Boolean    @default(false)
  consumedAt        DateTime?
  expiresAt         DateTime
  resendAvailableAt DateTime
  createdAt         DateTime   @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([email, purpose])
  @@map("user_otp_verifications")
}

model UserPasswordResetToken {
  id        String    @id @default(cuid(2))
  userId    String
  tokenHash String    @unique
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("user_password_reset_tokens")
}

// ============================================================================
// 2. Tenancy & Collaboration Models
// ============================================================================

enum AccountOffboardingState {
  NONE
  PENDING
  COMPLETED
}

model Account {
  id               String                  @id @default(cuid(2))
  name             String
  slug             String                  @unique
  ownerId          String
  offboardingState AccountOffboardingState @default(NONE)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  // Relationships
  owner           User                 @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  workspaces      Workspace[]
  subscription    AccountSubscription?
  aiConversations AiConversation[]

  @@index([ownerId])
  @@map("accounts")
}

enum WorkspaceLifecycleStatus {
  ACTIVE
  ARCHIVED
}

model Workspace {
  id              String                   @id @default(cuid(2))
  accountId       String
  name            String
  slug            String                   @unique
  lifecycleStatus WorkspaceLifecycleStatus @default(ACTIVE)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  // Relationships
  account         Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  members         WorkspaceMember[]
  invitations     WorkspaceInvitation[]
  notifications   Notification[]
  projects        Project[]
  aiConversations AiConversation[]

  @@index([accountId])
  @@map("workspaces")
}

enum WorkspaceRole {
  ADMIN
  MEMBER
}

model WorkspaceMember {
  id          String        @id @default(cuid(2))
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  // Relationships
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model WorkspaceInvitation {
  id          String           @id @default(cuid(2))
  workspaceId String
  inviterId   String
  email       String
  role        WorkspaceRole    @default(MEMBER)
  hashedToken String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())

  // Relationships
  workspace Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  inviter   User                         @relation("WorkspaceInviter", fields: [inviterId], references: [id], onDelete: Restrict)
  projects  WorkspaceInvitationProject[]

  @@index([workspaceId, email])
  @@index([status, expiresAt])
  @@map("workspace_invitations")
}

/// Optional project pre-assignment carried by an invitation (CS-01, ADR-004).
model WorkspaceInvitationProject {
  id           String @id @default(cuid(2))
  invitationId String
  projectId    String

  invitation WorkspaceInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([invitationId, projectId])
  @@index([projectId])
  @@map("workspace_invitation_projects")
}

// ============================================================================
// 3. Projects & Task Execution Models
// ============================================================================

enum ProjectLifecycleStatus {
  ACTIVE
  ARCHIVED
}

/// Role inside one project (CS-05, ADR-012). Workspace admins and the account owner always have admin rights everywhere.
enum ProjectRole {
  ADMIN
  MEMBER
}

/// Fixed, small category set for tasks (CS-05). Optional on every task.
enum TaskCategory {
  FEATURE
  BUG
  IMPROVEMENT
  DESIGN
  RESEARCH
  DOCS
  OTHER
}

model Project {
  id                String                 @id @default(cuid(2))
  workspaceId       String
  name              String
  key               String                 @db.VarChar(5)
  description       String?
  lifecycleStatus   ProjectLifecycleStatus @default(ACTIVE)
  deletedAt         DateTime?
  isBillingReadOnly Boolean                @default(false)
  /// The user who created the project: its protected owner (cannot be demoted or removed by other project admins).
  createdById       String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  // Relationships
  workspace          Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy          User?                        @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members            ProjectMember[]
  tasks              Task[]
  invitationProjects WorkspaceInvitationProject[]

  @@unique([workspaceId, key])
  @@index([workspaceId, lifecycleStatus])
  @@index([workspaceId, deletedAt])
  @@map("projects")
}

model ProjectMember {
  id         String      @id @default(cuid(2))
  projectId  String
  userId     String
  role       ProjectRole @default(MEMBER)
  assignedAt DateTime    @default(now())

  // Relationships
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String        @id @default(cuid(2))
  projectId   String
  title       String
  description String?
  status      TaskStatus    @default(TODO)
  priority    TaskPriority  @default(MEDIUM)
  authorId    String
  assigneeId  String?
  dueDate     DateTime?
  category    TaskCategory?
  completedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relationships
  project  Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  author   User          @relation("TaskAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  assignee User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments TaskComment[]

  @@index([projectId, status])
  @@index([projectId, deletedAt])
  @@index([projectId, completedAt])
  @@index([assigneeId])
  @@index([authorId])
  @@map("tasks")
}

model TaskComment {
  id        String    @id @default(cuid(2))
  taskId    String
  authorId  String
  content   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relationships
  task   Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([authorId])
  @@map("task_comments")
}

// ============================================================================
// 4. Billing & Capacity Subscription Models
// ============================================================================

enum SubscriptionPlanTier {
  FREE
  PRO
  ENTERPRISE
  EPIC
}

enum AiPlanTier {
  FREE
  PRO
  ENTERPRISE
  EPIC
}

enum SubscriptionPaymentStatus {
  ACTIVE
  PAST_DUE
  DOWNGRADED
}

model AccountSubscription {
  id                       String                    @id @default(cuid(2))
  accountId                String                    @unique
  tier                     SubscriptionPlanTier      @default(FREE)
  status                   SubscriptionPaymentStatus @default(ACTIVE)
  cancelAtPeriodEnd        Boolean                   @default(false)
  canceledAt               DateTime?
  billingCycleEndsAt       DateTime?
  gracePeriodEndsAt        DateTime?
  requiresProjectSelection Boolean                   @default(false)
  providerCustomerId       String?
  providerSubscriptionId   String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  // Relationships
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  billingEvents BillingEvent[]

  @@index([tier, status])
  @@map("account_subscriptions")
}

model UserAiSubscription {
  id                 String                    @id @default(cuid(2))
  userId             String                    @unique
  tier               AiPlanTier                @default(FREE)
  dailyQuota         Int                       @default(3)
  status             SubscriptionPaymentStatus @default(ACTIVE)
  cancelAtPeriodEnd  Boolean                   @default(false)
  canceledAt         DateTime?
  billingCycleEndsAt DateTime?
  gracePeriodEndsAt  DateTime?
  providerCustomerId String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  // Relationships
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  billingEvents BillingEvent[]

  @@index([tier, status])
  @@map("user_ai_subscriptions")
}

model BillingEvent {
  id                    String   @id @default(cuid(2))
  accountSubscriptionId String?
  userAiSubscriptionId  String?
  eventType             String
  externalEventId       String   @unique
  amount                Int?
  currency              String?
  occurredAt            DateTime @default(now())
  createdAt             DateTime @default(now())

  // Relationships
  accountSubscription AccountSubscription? @relation(fields: [accountSubscriptionId], references: [id], onDelete: SetNull)
  userAiSubscription  UserAiSubscription?  @relation(fields: [userAiSubscriptionId], references: [id], onDelete: SetNull)

  @@index([accountSubscriptionId])
  @@index([userAiSubscriptionId])
  @@map("billing_events")
}

// ============================================================================
// 5. AI Assistant & Usage Quota Models
// ============================================================================

model AiDailyUsage {
  id           String   @id @default(cuid(2))
  userId       String
  usageDate    DateTime @db.Date
  messagesUsed Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, usageDate])
  @@index([usageDate])
  @@map("ai_daily_usages")
}

enum AiReservationStatus {
  PENDING
  FINALIZED
  COMPENSATED
}

model AiUsageReservation {
  id                 String              @id @default(cuid(2))
  userId             String
  idempotencyKey     String
  requestHash        String              @db.VarChar(64)
  status             AiReservationStatus @default(PENDING)
  usageDate          DateTime            @db.Date
  conversationId     String?
  finalizedMessageId String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([userId, usageDate])
  @@index([status, createdAt])
  @@map("ai_usage_reservations")
}

enum AiMode {
  KNOWLEDGE
  PROJECT
}

enum AiContextScope {
  GLOBAL
  WORKSPACE
  ACCOUNT
}

model AiConversation {
  id           String         @id @default(cuid(2))
  userId       String
  mode         AiMode         @default(KNOWLEDGE)
  contextScope AiContextScope @default(GLOBAL)
  accountId    String?
  workspaceId  String?
  title        String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relationships
  user      User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  account   Account?             @relation(fields: [accountId], references: [id], onDelete: SetNull)
  workspace Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  messages  AiMessage[]
  proposals AiMutationProposal[]

  @@index([userId, updatedAt])
  @@index([workspaceId])
  @@index([accountId])
  @@map("ai_conversations")
}

enum AiSenderRole {
  USER
  ASSISTANT
}

model AiMessage {
  id             String       @id @default(cuid(2))
  conversationId String
  senderRole     AiSenderRole
  content        String
  citations      Json?
  createdAt      DateTime     @default(now())

  // Relationships
  conversation AiConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// The mutation proposal this assistant message carries, if any (CS-06).
  proposal     AiMutationProposal?

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

enum AiProposalTargetType {
  PROJECT
  TASK
}

enum AiProposalMutationType {
  CREATE
  UPDATE
}

enum AiProposalStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXECUTED
  FAILED
}

model AiMutationProposal {
  id                String                 @id @default(cuid(2))
  conversationId    String
  targetEntityType  AiProposalTargetType
  mutationAction    AiProposalMutationType
  targetEntityId    String?
  targetWorkspaceId String?
  targetProjectId   String?
  proposedPayload   Json
  /// The assistant message that carries this proposal (CS-06).
  messageId         String?                @unique
  status            AiProposalStatus       @default(PENDING)
  createdAt         DateTime               @default(now())
  executedAt        DateTime?

  // Relationships
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      AiMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([conversationId, status])
  @@map("ai_mutation_proposals")
}

// ============================================================================
// 6. Audit & Compliance Models
// ============================================================================

model AuditLog {
  id          String   @id @default(cuid(2))
  actorUserId String?
  accountId   String?
  workspaceId String?
  projectId   String?
  taskId      String?
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}


// ============================================================================
// CONTACT (CS-10, ADR-017)
// ============================================================================

enum ContactTopic {
  QUESTION
  PROBLEM
  BILLING
  FEEDBACK
  OTHER
}

enum ContactStatus {
  NEW
  HANDLED
}

/// A message from the public Contact us form. Read by the team from this table until the email provider is connected.
model ContactMessage {
  id        String        @id @default(cuid(2))
  name      String
  email     String
  topic     ContactTopic
  message   String
  /// Salted SHA-256 of the sender's network address: enough to rate-limit, not to identify a person.
  ipHash    String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
  @@index([status, createdAt])
  @@map("contact_messages")
}

// ============================================================================
// AI knowledge base (Phase 5, step 5.8b): chunks of the public Veyro help documents with their embeddings (BR-AI-06, DEC-12).
// No tenant column on purpose: this corpus is public product documentation and never holds customer data.
// Written only by the ingest script (raw SQL: Prisma cannot create the vector type); searched with raw SQL.
// ============================================================================
model KnowledgeChunk {
  id        String     @id @default(cuid(2))
  locale    UserLocale
  source    String
  heading   String
  position  Int
  content   String
  embedding Unsupported("vector(768)")
  createdAt DateTime   @default(now())

  @@index([locale])
  @@map("knowledge_base_embeddings")
}

// ============================================================================
// Notifications (step 5.9, Phase C)
// ============================================================================

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENTED
  ADDED_TO_PROJECT
  ROLE_CHANGED
  INVITATION_ACCEPTED
}

/// An in-app notification for one person. Written in the same transaction as the event that caused it, so the event and its
/// notification exist together or not at all. The text is built on screen from `type` and `data`, never stored as a sentence.
model Notification {
  id          String           @id @default(cuid(2))
  recipientId String
  workspaceId String
  type        NotificationType
  actorId     String?
  projectId   String?
  taskId      String?
  /// What the text needs, copied when the event happened (task title, project name and key, workspace name and slug, role,
  /// actor name), so a later rename or delete does not rewrite history.
  data        Json
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  recipient User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([recipientId, readAt])
  @@map("notifications")
}
