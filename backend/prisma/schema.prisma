// ============================================================================
// Veyro Database Schema (Prisma ORM 7 / PostgreSQL 16+)
// Document Reference: docs/04-ENTITY-RELATIONSHIP-SPECIFICATION.md
// Phase 2: STEP-2.2 Physical Schema Design
// ============================================================================

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// 1. Identity & Session Models
// ============================================================================

model User {
  id           String   @id @default(cuid(2))
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  isEmailVerified Boolean  @default(false)
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  ownedAccounts           Account[]              @relation("AccountOwner")
  sessions                UserSession[]
  workspaceMemberships    WorkspaceMember[]
  projectMemberships      ProjectMember[]
  authoredTasks           Task[]                 @relation("TaskAuthor")
  assignedTasks           Task[]                 @relation("TaskAssignee")
  taskComments            TaskComment[]
  aiSubscription          UserAiSubscription?
  aiUsageRecords          AiDailyUsage[]
  aiUsageReservations     AiUsageReservation[]
  aiConversations         AiConversation[]
  sentWorkspaceInvitations WorkspaceInvitation[] @relation("WorkspaceInviter")
  otpVerifications        UserOtpVerification[]
  passwordResetTokens     UserPasswordResetToken[]

  @@map("users")
}

model UserSession {
  id          String   @id @default(cuid(2))
  userId      String
  hashedToken String   @unique
  familyId    String
  isRevoked   Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("user_sessions")
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model UserOtpVerification {
  id                String     @id @default(cuid(2))
  userId            String
  email             String
  codeHash          String
  purpose           OtpPurpose @default(EMAIL_VERIFICATION)
  attempts          Int        @default(0)
  maxAttempts       Int        @default(5)
  isConsumed        Boolean    @default(false)
  consumedAt        DateTime?
  expiresAt         DateTime
  resendAvailableAt DateTime
  createdAt         DateTime   @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([email, purpose])
  @@map("user_otp_verifications")
}

model UserPasswordResetToken {
  id        String    @id @default(cuid(2))
  userId    String
  tokenHash String    @unique
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("user_password_reset_tokens")
}

// ============================================================================
// 2. Tenancy & Collaboration Models
// ============================================================================

enum AccountOffboardingState {
  NONE
  PENDING
  COMPLETED
}

model Account {
  id               String                  @id @default(cuid(2))
  name             String
  slug             String                  @unique
  ownerId          String
  offboardingState AccountOffboardingState @default(NONE)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  // Relationships
  owner           User                 @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  workspaces      Workspace[]
  subscription    AccountSubscription?
  aiConversations AiConversation[]

  @@index([ownerId])
  @@map("accounts")
}

enum WorkspaceLifecycleStatus {
  ACTIVE
  ARCHIVED
}

model Workspace {
  id              String                   @id @default(cuid(2))
  accountId       String
  name            String
  slug            String                   @unique
  lifecycleStatus WorkspaceLifecycleStatus @default(ACTIVE)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  // Relationships
  account         Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  members         WorkspaceMember[]
  invitations     WorkspaceInvitation[]
  projects        Project[]
  aiConversations AiConversation[]

  @@index([accountId])
  @@map("workspaces")
}

enum WorkspaceRole {
  ADMIN
  MEMBER
}

model WorkspaceMember {
  id          String        @id @default(cuid(2))
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  // Relationships
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model WorkspaceInvitation {
  id          String           @id @default(cuid(2))
  workspaceId String
  inviterId   String
  email       String
  role        WorkspaceRole    @default(MEMBER)
  hashedToken String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())

  // Relationships
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  inviter   User      @relation("WorkspaceInviter", fields: [inviterId], references: [id], onDelete: Restrict)

  @@index([workspaceId, email])
  @@index([status, expiresAt])
  @@map("workspace_invitations")
}

// ============================================================================
// 3. Projects & Task Execution Models
// ============================================================================

enum ProjectLifecycleStatus {
  ACTIVE
  ARCHIVED
}

model Project {
  id                String                 @id @default(cuid(2))
  workspaceId       String
  name              String
  description       String?
  lifecycleStatus   ProjectLifecycleStatus @default(ACTIVE)
  deletedAt         DateTime?
  isBillingReadOnly Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  // Relationships
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  members   ProjectMember[]
  tasks     Task[]

  @@index([workspaceId, lifecycleStatus])
  @@index([workspaceId, deletedAt])
  @@map("projects")
}

model ProjectMember {
  id         String   @id @default(cuid(2))
  projectId  String
  userId     String
  assignedAt DateTime @default(now())

  // Relationships
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(cuid(2))
  projectId   String
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  authorId    String
  assigneeId  String?
  dueDate     DateTime?
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relationships
  project  Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  author   User          @relation("TaskAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  assignee User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments TaskComment[]

  @@index([projectId, status])
  @@index([projectId, deletedAt])
  @@index([assigneeId])
  @@index([authorId])
  @@map("tasks")
}

model TaskComment {
  id        String    @id @default(cuid(2))
  taskId    String
  authorId  String
  content   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relationships
  task   Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([authorId])
  @@map("task_comments")
}

// ============================================================================
// 4. Billing & Capacity Subscription Models
// ============================================================================

enum SubscriptionPlanTier {
  FREE
  PRO
  ENTERPRISE
  EPIC
}

enum AiPlanTier {
  FREE
  PRO
  ENTERPRISE
  EPIC
}

enum SubscriptionPaymentStatus {
  ACTIVE
  PAST_DUE
  DOWNGRADED
}

model AccountSubscription {
  id                       String                    @id @default(cuid(2))
  accountId                String                    @unique
  tier                     SubscriptionPlanTier      @default(FREE)
  status                   SubscriptionPaymentStatus @default(ACTIVE)
  cancelAtPeriodEnd        Boolean                   @default(false)
  canceledAt               DateTime?
  billingCycleEndsAt       DateTime?
  gracePeriodEndsAt        DateTime?
  requiresProjectSelection Boolean                   @default(false)
  providerCustomerId       String?
  providerSubscriptionId   String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  // Relationships
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  billingEvents BillingEvent[]

  @@index([tier, status])
  @@map("account_subscriptions")
}

model UserAiSubscription {
  id                 String                    @id @default(cuid(2))
  userId             String                    @unique
  tier               AiPlanTier                @default(FREE)
  dailyQuota         Int                       @default(3)
  status             SubscriptionPaymentStatus @default(ACTIVE)
  cancelAtPeriodEnd  Boolean                   @default(false)
  canceledAt         DateTime?
  billingCycleEndsAt DateTime?
  gracePeriodEndsAt  DateTime?
  providerCustomerId String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  // Relationships
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  billingEvents BillingEvent[]

  @@index([tier, status])
  @@map("user_ai_subscriptions")
}

model BillingEvent {
  id                    String   @id @default(cuid(2))
  accountSubscriptionId String?
  userAiSubscriptionId  String?
  eventType             String
  externalEventId       String   @unique
  amount                Int?
  currency              String?
  occurredAt            DateTime @default(now())
  createdAt             DateTime @default(now())

  // Relationships
  accountSubscription AccountSubscription? @relation(fields: [accountSubscriptionId], references: [id], onDelete: SetNull)
  userAiSubscription  UserAiSubscription?  @relation(fields: [userAiSubscriptionId], references: [id], onDelete: SetNull)

  @@index([accountSubscriptionId])
  @@index([userAiSubscriptionId])
  @@map("billing_events")
}

// ============================================================================
// 5. AI Assistant & Usage Quota Models
// ============================================================================

model AiDailyUsage {
  id           String   @id @default(cuid(2))
  userId       String
  usageDate    DateTime @db.Date
  messagesUsed Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, usageDate])
  @@index([usageDate])
  @@map("ai_daily_usages")
}

enum AiReservationStatus {
  PENDING
  FINALIZED
  COMPENSATED
}

model AiUsageReservation {
  id                 String              @id @default(cuid(2))
  userId             String
  idempotencyKey     String
  requestHash        String              @db.VarChar(64)
  status             AiReservationStatus @default(PENDING)
  usageDate          DateTime            @db.Date
  conversationId     String?
  finalizedMessageId String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([userId, usageDate])
  @@index([status, createdAt])
  @@map("ai_usage_reservations")
}

enum AiMode {
  KNOWLEDGE
  PROJECT
}

enum AiContextScope {
  GLOBAL
  WORKSPACE
  ACCOUNT
}

model AiConversation {
  id           String         @id @default(cuid(2))
  userId       String
  mode         AiMode         @default(KNOWLEDGE)
  contextScope AiContextScope @default(GLOBAL)
  accountId    String?
  workspaceId  String?
  title        String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relationships
  user      User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  account   Account?              @relation(fields: [accountId], references: [id], onDelete: SetNull)
  workspace Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  messages  AiMessage[]
  proposals AiMutationProposal[]

  @@index([userId, updatedAt])
  @@index([workspaceId])
  @@index([accountId])
  @@map("ai_conversations")
}

enum AiSenderRole {
  USER
  ASSISTANT
}

model AiMessage {
  id             String       @id @default(cuid(2))
  conversationId String
  senderRole     AiSenderRole
  content        String
  citations      Json?
  createdAt      DateTime     @default(now())

  // Relationships
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

enum AiProposalTargetType {
  PROJECT
  TASK
}

enum AiProposalMutationType {
  CREATE
  UPDATE
}

enum AiProposalStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXECUTED
  FAILED
}

model AiMutationProposal {
  id                String                 @id @default(cuid(2))
  conversationId    String
  targetEntityType  AiProposalTargetType
  mutationAction    AiProposalMutationType
  targetEntityId    String?
  targetWorkspaceId String?
  targetProjectId   String?
  proposedPayload   Json
  status            AiProposalStatus       @default(PENDING)
  createdAt         DateTime               @default(now())
  executedAt        DateTime?

  // Relationships
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
  @@map("ai_mutation_proposals")
}

// ============================================================================
// 6. Audit & Compliance Models
// ============================================================================

model AuditLog {
  id          String   @id @default(cuid(2))
  actorUserId String?
  accountId   String?
  workspaceId String?
  projectId   String?
  taskId      String?
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}
